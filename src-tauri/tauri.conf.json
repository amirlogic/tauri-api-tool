{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri API Tool",
  "version": "0.1.2",
  "identifier": "com.tauriapi.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tauri API Tool",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {}
  },
  "plugins": {
    "description": "The plugins config.",
    "deep-link": {
      "desktop": {
        "schemes": [
          "markdown",
          "mdviewer"
        ]
      }
    },
    "cli": {
      "description": "Tauri CLI Plugin Example",
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ],
      "subcommands": {
        "run": {
          "description": "Run the application",
          "args": [
            {
              "name": "debug",
              "description": "Run application in debug mode"
            },
            {
              "name": "release",
              "description": "Run application in release mode"
            },
            {
              "name": "open",
              "description": "Open File"
            }
          ]
        }
      }
    }
  }
}