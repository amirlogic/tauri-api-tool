{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-path",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    "store:default",
    "dialog:default",
    "shell:allow-open",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "magick",
          "cmd": "magick",
          "args": true,
          "sidecar": false
        },
	      {
          "name": "ffmpeg",
          "cmd": "ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pnpm",
          "cmd": "pnpm",
          "args": true,
          "sidecar": false
        },
        {
          "name": "node",
          "cmd": "node",
          "args": true,
          "sidecar": false
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true,
          "sidecar": false
        },
        {
          "name": "python",
          "cmd": "python",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "os:default",
    "sql:allow-close",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "core:event:default",
    "deep-link:default"
  ]
}